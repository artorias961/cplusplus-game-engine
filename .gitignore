# Build output — fully regenerated by CMake/MSVC, never commit this
/build/
/out/
build-*/
cmake-build-*/

# Stray build artifacts, in case anyone configures in the source tree
CMakeCache.txt
CMakeFiles/
*.obj
*.exe
*.dll
*.pdb
*.ilk

# Editor / tooling
.vs/
.vscode/
.idea/
*.vcxproj.user
CMakeUserPresets.json
compile_commands.json

# Reference material that must never enter git history: large binaries can't be
# removed later without rewriting history, and third-party game packages aren't
# ours to redistribute.
*.apk
*.ipa
*.zip
*.7z

# OS junk
Thumbs.db
.DS_Store
